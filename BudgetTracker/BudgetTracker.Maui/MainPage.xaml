<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BudgetTracker.Maui.MainPage"
             Title="Budget Tracker">

    <!-- Main page for the Budget Tracker app. -->

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">
            
           <Label 
            Text="Budget Tracker"
            FontSize="28"
            FontAttributes="Bold"/>

           <Button x:Name="AddTransactionButton"
                   Text="Add Transaction"
                   Clicked="OnAddTransactionClicked"
                   BackgroundColor="#FF005EFF"
                   TextColor="White"/>

            <Button x:Name="ShowReportButton"
                Text="Show Report"
                Clicked="OnShowReportClicked"/>

        <VerticalStackLayout x:Name="ReportPanel" IsVisible="False" Spacing="4">
            <Label x:Name="TotalIncomeLabel" FontAttributes="Bold"/>
            <Label x:Name="TotalExpenseLabel" FontAttributes="Bold"/>
            <Label x:Name="NetBalanceLabel" FontAttributes="Bold"/>
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="LightGray"/>
        <Label Text="Transactions" FontSize="20" FontAttributes="Bold"/>
    <CollectionView x:Name="TransactionsCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Description}" FontAttributes="Bold" />
                                <Label Text="{Binding Type}" FontSize="12" />
                                <Label Text="{Binding Amount, StringFormat='{0:C}'}" FontSize="12" />
                                <Label Text="{Binding Date, StringFormat='{0:d}'}" FontSize="12" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Edit"
                                    Clicked="OnEditTransactionClicked"
                                    CommandParameter="{Binding Id}" />

                            <Button Grid.Column="2"
                                    Text="Delete"
                                    Clicked="OnDeleteTransactionClicked"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#FFDC3545"
                                    TextColor="White" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
